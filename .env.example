# ===========================================
# Skillora Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Skillora

# Database (PostgreSQL)
DATABASE_URL=postgresql://skillora:skillora@localhost:5432/skillora_dev

# Authentication (NextAuth.js)
AUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Stripe Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# File Upload
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Email (Resend)
RESEND_API_KEY=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI (Google Gemini)
# Get a free API key at: https://aistudio.google.com → "Get API key"
# Required for AI course description + AI quiz questions features.
# If unset, the AI buttons are hidden in the UI.
GEMINI_API_KEY=

# Optional: override the Gemini model.
# Default: gemini-2.5-flash  (free, 10 RPM, 250 RPD, best capability/limit balance)
# Alternatives on the free tier:
#   - gemini-2.5-flash-lite   (30 RPM, 1000 RPD, slightly lower quality)
#   - gemini-3-flash          (newest, reduced free quota)
#   - gemini-3.1-flash-lite   (cheapest, smallest)
# GEMINI_MODEL=gemini-2.5-flash
