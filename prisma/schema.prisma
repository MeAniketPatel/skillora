generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ USERS & AUTH ============

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum AuthAuditAction {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT_SESSION
  LOGOUT_ALL_SESSIONS
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  PROFILE_UPDATED
  SESSION_REVOKED
  SESSION_BLACKLISTED
  USER_BANNED
  USER_UNBANNED
  COURSE_APPROVED
  COURSE_REJECTED
  ROLE_CHANGED
}

enum AuthSessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_RESET
  PASSWORD_CHANGE
  SECURITY
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             Role      @default(STUDENT)
  bio              String?   @db.Text
  headline         String?
  socialLinks      Json? // e.g. { "twitter": "...", "linkedin": "..." }
  stripeCustomerId String?
  stripeConnectId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isBanned         Boolean   @default(false)
  bannedAt         DateTime?
  bannedReason     String?
  points           Int       @default(0)

  // NextAuth
  accounts            Account[]
  sessions            Session[]
  authSessions        AuthSession[]
  authTokenBlacklist  AuthTokenBlacklist[]
  authAuditLogs       AuthAuditLog[]
  passwordResetTokens PasswordResetToken[]

  // Relations
  courses       Course[] // taught courses
  enrollments   Enrollment[]
  reviews       Review[]
  purchases     Purchase[]
  notifications Notification[]
  notes         Note[]
  questions     Question[]
  answers       Answer[]
  submissions   AssignmentSubmission[]
  wishlist      Wishlist[]
  studyStreak          StudyStreak?
  studySessions        StudySession[]
  bookmarks            Bookmark[]
  learningGoals        LearningGoal[]
  courseCollections     CourseCollection[]
  announcements        Announcement[]
  payoutRequests       PayoutRequest[]
  peerReviewsGiven     PeerReview[]            @relation("ReviewerReviews")
  peerReviewsReceived  PeerReview[]            @relation("RevieweeReviews")
  pollsCreated         Poll[]
  pollVotes            PollVote[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model AuthSession {
  id           String                       @id @default(cuid())
  sessionId    String                       @unique
  userId       String
  user         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String?
  ipAddress    String?
  userAgent    String?                      @db.Text
  expiresAt    DateTime
  lastSeenAt   DateTime                     @default(now())
  revokedAt    DateTime?
  revokeReason AuthSessionRevocationReason?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthTokenBlacklist {
  id        String                      @id @default(cuid())
  sessionId String                      @unique
  userId    String
  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    AuthSessionRevocationReason
  expiresAt DateTime
  createdAt DateTime                    @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model AuthAuditLog {
  id        String          @id @default(cuid())
  action    AuthAuditAction
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  ipAddress String?
  userAgent String?         @db.Text
  metadata  Json?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([email])
}

// ============ COURSES ============

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  ARCHIVED
}

model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  description      String?      @db.Text
  shortDescription String?
  thumbnail        String?
  promoVideo       String?
  price            Float?
  currency         String       @default("USD")
  level            CourseLevel  @default(BEGINNER)
  status           CourseStatus @default(DRAFT)
  language         String       @default("en")
  duration         Int? // estimated minutes
  learningOutcomes String[]
  requirements     String[]
  targetAudience   String[]
  isFeatured       Boolean      @default(false)
  publishedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  teacherId    String
  teacher      User         @relation(fields: [teacherId], references: [id])
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id])
  sections     Section[]
  enrollments  Enrollment[]
  reviews      Review[]
  coupons      Coupon[]
  tags         Tag[]
  wishlistedBy Wishlist[]
  collections  CollectionCourse[]
  announcements Announcement[]
  polls         Poll[]
}

model Section {
  id        String   @id @default(cuid())
  title     String
  position  Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
}

model Lesson {
  id            String     @id @default(cuid())
  title         String
  type          LessonType @default(VIDEO)
  content       String?    @db.Text // rich text for ARTICLE type
  videoUrl      String?
  videoDuration Int? // seconds
  position      Int
  isFree        Boolean    @default(false)
  isPublished   Boolean    @default(false)
  sectionId     String
  section       Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  attachments Attachment[]
  progress    LessonProgress[]
  quiz        Quiz?
  notes       Note[]
  questions   Question[]
  submissions AssignmentSubmission[]
  bookmarks   Bookmark[]
  peerReviewConfig PeerReviewAssignment?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model Attachment {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int?
  type      String?
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ============ ENROLLMENT & PROGRESS ============

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  progress    Float     @default(0) // 0-100
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lessonProgress LessonProgress[]
  certificate    Certificate?
  purchase       Purchase?

  @@unique([userId, courseId])
}

model LessonProgress {
  id            String     @id @default(cuid())
  isCompleted   Boolean    @default(false)
  completedAt   DateTime?
  videoPosition Int? // seconds — resume position
  enrollmentId  String
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson     @relation(fields: [lessonId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([enrollmentId, lessonId])
}

// ============ PAYMENTS ============

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Purchase {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  enrollmentId    String        @unique
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id])
  amount          Float
  currency        String        @default("USD")
  stripePaymentId String?       @unique
  status          PaymentStatus @default(PENDING)
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  createdAt       DateTime      @default(now())
}

// ============ ASSESSMENTS ============

model Quiz {
  id           String         @id @default(cuid())
  title        String
  timeLimit    Int? // minutes
  passingScore Int            @default(70)
  maxAttempts  Int?
  lessonId     String         @unique
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTI_SELECT
  TRUE_FALSE
  SHORT_ANSWER
}

model QuizQuestion {
  id          String       @id @default(cuid())
  question    String       @db.Text
  type        QuestionType @default(MULTIPLE_CHOICE)
  options     Json // array of { text, isCorrect }
  explanation String?      @db.Text
  points      Int          @default(1)
  position    Int
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  score       Float
  passed      Boolean
  answers     Json // student answers
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id])
  userId      String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
}

// ============ SOCIAL & COMMUNITY ============

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model Question {
  id         String   @id @default(cuid())
  title      String
  body       String   @db.Text
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
  answers    Answer[]
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Answer {
  id         String   @id @default(cuid())
  body       String   @db.Text
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  timestamp Int? // video timestamp in seconds
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ MISC ============

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  icon    String?
  courses Course[]
}

model Tag {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id        String       @id @default(cuid())
  code      String       @unique
  discount  Float // percentage or fixed amount
  type      DiscountType @default(PERCENTAGE)
  maxUses   Int?
  usedCount Int          @default(0)
  expiresAt DateTime?
  courseId  String?
  course    Course?      @relation(fields: [courseId], references: [id])
  purchases Purchase[]
  createdAt DateTime     @default(now())
}

model Certificate {
  id            String     @id @default(cuid())
  certificateId String     @unique // public verification ID
  enrollmentId  String     @unique
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])
  issuedAt      DateTime   @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model AssignmentSubmission {
  id            String    @id @default(cuid())
  content       String    @db.Text
  attachmentUrl String?
  score         Float?
  feedback      String?   @db.Text
  status        String    @default("SUBMITTED")
  lessonId      String
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt   DateTime  @default(now())
  gradedAt      DateTime?
  peerReviews   PeerReview[]

  @@unique([userId, lessonId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String    @db.Text
  isReplied Boolean   @default(false)
  repliedAt DateTime?
  repliedBy String?
  createdAt DateTime  @default(now())

  @@index([isReplied])
  @@index([createdAt])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ============ STUDENT PORTAL (PHASE 2) ============

model StudyStreak {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  freezeCount      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  duration  Int      // in seconds
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model LearningGoal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // "WEEKLY" | "MONTHLY"
  target     Int      // target number of lessons
  current    Int      @default(0)
  targetDate DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CourseCollection {
  id          String             @id @default(cuid())
  userId      String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?            @db.Text
  courses     CollectionCourse[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model CollectionCourse {
  id           String           @id @default(cuid())
  collectionId String
  collection   CourseCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@unique([collectionId, courseId])
}

// ============ TEACHER PORTAL (PHASE 3) ============

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model PayoutRequest {
  id          String    @id @default(cuid())
  amount      Float
  status      String    @default("PENDING") // PENDING, PAID, REJECTED
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model PeerReview {
  id           String               @id @default(cuid())
  submissionId String
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User                 @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId   String
  reviewee     User                 @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Cascade)
  score        Float
  feedback     String               @db.Text
  createdAt    DateTime             @default(now())
}

model PeerReviewAssignment {
  id              String   @id @default(cuid())
  lessonId        String   @unique
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  requiredReviews Int      @default(3)
  dueDate         DateTime
  createdAt       DateTime @default(now())
}

model Poll {
  id        String       @id @default(cuid())
  question  String
  courseId  String
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  options   PollOption[]
  createdAt DateTime     @default(now())
  closedAt  DateTime?
}

model PollOption {
  id     String     @id @default(cuid())
  text   String
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id       String     @id @default(cuid())
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, optionId])
}

// ============ ADMIN COMMAND CENTER (PHASE 4) ============

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  rolloutPct  Int      @default(100) // 0-100% gradual rollout
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationContentType {
  REVIEW
  DISCUSSION
  BLOG_POST
  COMMENT
}

model ModerationItem {
  id          String                @id @default(cuid())
  contentType ModerationContentType
  contentId   String  // ID of the flagged review / discussion / blog
  reason      String?
  status      ModerationStatus      @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([contentType, contentId])
}
